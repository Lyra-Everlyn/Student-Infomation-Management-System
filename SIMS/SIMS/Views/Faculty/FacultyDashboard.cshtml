@model SIMS.Models.ViewModels.FacultyDashboardViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIMS Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="~/img/logo.png" type="image/x-icon">
    <link rel="stylesheet" href="~/css/dashboard.css">
    <link rel="stylesheet" href="~/css/profile.css" />
</head>
<body>
    <aside class="sidebar">
        <a class="logo">
            <img src="~/img/logo.png">
            <span>Evolyne</span>
        </a>
        <a class="nav-link active" data-tab="tab-home">
            <i class="fa-solid fa-house"></i> Home
        </a>
        <a class="nav-link" data-tab="tab-profile">
            <i class="fa-solid fa-user"></i> My Profile
        </a>
        <a class="nav-link" data-tab="tab-courses">
            <i class="fa-solid fa-layer-group"></i> Teaching Courses
        </a>
        <div class="log-out">
            <partial name="_LogoutFormPartial" />
            <a href="#" onclick="handleLogout(event)" class="nav-link">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
        </div>
    </aside>

    <main class="main">

        <!-- Tab Home -->
        <div id="tab-home" class="tab-content active">
            <div class="home-container">
                <h1 class="home-title">
                    Welcome back, @(User.Identity?.Name ?? "Falcuty")! 👋
                </h1>
                <img src="~/img/tab-home.png" alt="Welcome Illustration" class="home-image" />
            </div>
        </div>

        <!-- Tab Profile -->
        <div id="tab-profile" class="tab-content">
            <div class="tab-header">
                <h1>My Instructor Profile</h1>
            </div>

            <div class="profile-container">
                <div class="profile-card-header">
                    <div class="profile-avatar-wrapper">
                        <div class="profile-avatar">
                            @(Model?.CurrentFaculty.User?.FullName?.Substring(0, 1).ToUpper() ?? "F")
                        </div>
                    </div>
                    <div class="profile-user-info">
                        <h2>@(Model?.CurrentFaculty.User?.FullName ?? "N/A")</h2>
                        
                        <div class="profile-badges">
                            <span class="badge-role" style="background: #fff0f3; color: #e71d36;">
                                <i class="fa-solid fa-briefcase"></i> Instructor
                            </span>
                            <span class="status-badge status-active">Active</span>
                        </div>
                    </div>
                </div>

                <div class="profile-grid">

                    <div class="profile-section-card">
                        <h3 class="profile-section-title">
                            <i class="fa-solid fa-building-columns"></i> Professional Details
                        </h3>

                        <div class="info-group">
                            <span class="info-label">Department</span>
                            <div class="info-value">@(Model?.CurrentFaculty.Department?.DepartmentName ?? "Unassigned")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">System Role</span>
                            <div class="info-value">Faculty Member</div>
                        </div>
                    </div>

                    <div class="profile-section-card">
                        <h3 class="profile-section-title">
                            <i class="fa-solid fa-user-gear"></i> Personal & Account
                        </h3>

                        <div class="info-group">
                            <span class="info-label">Email Address</span>
                            <div class="info-value">@(Model?.CurrentFaculty.User?.Email ?? "N/A")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Phone Number</span>
                            <div class="info-value">@(Model?.CurrentFaculty.User?.PhoneNumber ?? "Not provided")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Date of Birth</span>
                            <div class="info-value">
                                @if (Model?.CurrentFaculty.User != null && Model.CurrentFaculty.User.DateOfBirth != DateTime.MinValue)
                                {
                                    <span>@Model.CurrentFaculty.User.DateOfBirth?.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span>Not provided</span>
                                }
                            </div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Address</span>
                            <div class="info-value">@(Model?.CurrentFaculty.User?.Address ?? "Not provided")</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- TAB: TEACHING COURSES -->
        <div id="tab-courses" class="tab-content">
            <div class="tab-header">
                <h1>My Teaching Courses</h1>
            </div>
            <div class="data-table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Course Name</th>
                            <th>Subject</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MyCourses == null || !Model.MyCourses.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 30px; color: gray;">
                                    You have not been assigned to teach any courses yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var crs in Model.MyCourses)
                            {
                                <tr>
                                    <td><strong>@crs.CourseName</strong></td>
                                    <td>@crs.Subject?.SubjectName</td>
                                    <td>@crs.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <a href="/Faculty/Assignment/Manage/@crs.CourseId" style="text-decoration: none">
                                            <i class="fa-solid fa-list-check"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script src="~/js/aside.js"></script>
    <script src="~/js/logout.js"></script>
    <script src="/js/manage-assignment.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/notify.js"></script>
    <script>
            window.SystemAlerts = {
                success: @Html.Raw(Json.Serialize(TempData["Success"]?.ToString())),
                error: @Html.Raw(Json.Serialize(TempData["Error"]?.ToString()))
            };
    </script>
</body>
</html>