@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIMS Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="~/img/logo.png" type="image/x-icon">
    <link rel="stylesheet" href="~/css/dashboard.css">
    <link rel="stylesheet" href="~/css/profile.css" />
</head>
<body>
    <aside class="sidebar">
        <a class="logo">
            <img src="~/img/logo.png">
            <span>Evolyne</span>
        </a>
        <a class="nav-link active" data-tab="tab-home">
            <i class="fa-solid fa-house"></i> Home
        </a>
        <a class="nav-link" data-tab="tab-profile">
            <i class="fa-solid fa-user"></i> My Profile
        </a>
        <a class="nav-link" data-tab="tab-courses">
            <i class="fa-solid fa-book-bookmark"></i> Enrolled Courses
        </a>

        <div class="log-out">
            <partial name="_LogoutFormPartial" />
            <a href="/api/auth/logout" onclick="handleLogout(event)" class="nav-link">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>
        </div>
    </aside>

    <main class="main">
        <!-- Tab Home -->
        <div id="tab-home" class="tab-content active">
            <div class="home-container">
                <h1 class="home-title">
                    Welcome back, @(User.Identity?.Name ?? "Student")! 👋
                </h1>
                <img src="~/img/tab-home.png" alt="Welcome Illustration" class="home-image" />
            </div>
        </div>

        <!-- Tab Profile -->
        <div id="tab-profile" class="tab-content active">
            <div class="tab-header">
                <h1>My Personal Profile</h1>
            </div>

            <div class="profile-container">

                <div class="profile-card-header">
                    <div class="profile-avatar-wrapper">
                        <div class="profile-avatar">
                            @(Model.CurrentStudent?.User?.FullName?.Substring(0, 1).ToUpper() ?? "S")
                        </div>
                    </div>
                    <div class="profile-user-info">
                        <h2>@(Model.CurrentStudent?.User?.FullName ?? "N/A")</h2>
                        <p><i class="fa-solid fa-id-card"></i> Student ID: <strong>@(Model.CurrentStudent?.StudentCode ?? "N/A")</strong></p>
                        <div class="profile-badges">
                            <span class="badge-role"><i class="fa-solid fa-user-graduate"></i> Student</span>
                            <span class="status-badge status-active">Active</span>
                        </div>
                    </div>
                </div>


                <div class="profile-grid">

                    <!-- CARD 1-->
                    <div class="profile-section-card">
                        <h3 class="profile-section-title">
                            <i class="fa-solid fa-graduation-cap"></i> Academic Details
                        </h3>

                        <div class="info-group">
                            <span class="info-label">Student Code</span>
                            <div class="info-value">@(Model.CurrentStudent?.StudentCode ?? "N/A")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Department / Major</span>
                            <div class="info-value">@(Model.CurrentStudent?.Department?.DepartmentName ?? "Unassigned")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Class</span>
                            <div class="info-value">@(Model.CurrentStudent?.Class?.ClassName ?? "Unassigned")</div>
                        </div>
                    </div>

                    <!-- CARD 2 -->
                    <div class="profile-section-card">
                        <h3 class="profile-section-title">
                            <i class="fa-solid fa-user-gear"></i> Personal & Account
                        </h3>

                        <div class="info-group">
                            <span class="info-label">Email Address</span>
                            <div class="info-value">@(Model.CurrentStudent?.User?.Email ?? "N/A")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Phone Number</span>
                            <div class="info-value">@(Model.CurrentStudent?.User?.PhoneNumber ?? "Not provided")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Date of Birth</span>
                            <div class="info-value">
                                @if (Model.CurrentStudent?.User != null && Model.CurrentStudent.User.DateOfBirth != DateTime.MinValue)
                                {
                                    <span>@Model.CurrentStudent.User.DateOfBirth.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span>Not provided</span>
                                }
                            </div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Address</span>
                            <div class="info-value">@(Model.CurrentStudent?.User?.Address ?? "Not provided")</div>
                        </div>

                        <div class="info-group">
                            <span class="info-label">Account Created At</span>
                            <div class="info-value">
                                @(Model.CurrentStudent?.User?.CreatedAt.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Tab All Courses-->
        <div id="tab-courses" class="tab-content">
            <div class="tab-header">
                <h1>My Enrolled Courses</h1>
                <button class="btn-create" data-modal-target="#modal-join-class">
                    <i class="fa-solid fa-right-to-bracket"></i> Join Class by Code
                </button>
            </div>

            <div class="data-table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Course Name</th>
                            <th>Subject</th>
                            <th>Instructor</th>
                            <th>Joined Date</th>
                            <th>Assignment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrollment in Model.MyEnrollments)
                        {
                            <tr>
                                <td><strong>@enrollment.Course?.CourseName</strong></td>
                                <td>@enrollment.Course?.Subject?.SubjectName</td>
                                <td>
                                    <i class="fa-solid fa-chalkboard-user"></i>
                                    @(enrollment.Course?.Faculty?.User?.FullName ?? "N/A")
                                </td>
                                <td>@enrollment.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="/Student/Assignment/List/@enrollment.CourseId" style="text-decoration: none;">
                                        <i class="fa-solid fa-folder-open"></i> View
                                    </a>
                                </td>
                                <td>
                                    @if (Model.CurrentStudent.Class != null &&
                                         !enrollment.Course.CourseName.Contains(Model.CurrentStudent.Class.ClassName))
                                    {
                                        <button class="btn-delete btn-leave-class" style="width: auto; padding: 6px 12px; font-size: 0.85rem;"
                                                data-id="@enrollment.CourseId"
                                                data-name="@enrollment.Course?.CourseName">
                                            <i class="fa-solid fa-door-open"></i> Leave
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-approved" style="background-color: #f1f3f5; color: #8d99ae;">
                                            <i class="fa-solid fa-lock"></i> Mandatory
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!--Modal Join class -->
        <div id="modal-join-class" class="modal" style="display:none;">
            <div class="modal-content">
                <span class="close-btn"><i class="fa-solid fa-xmark"></i></span>
                <h2>Join a Class</h2>
                <form asp-controller="Student" asp-action="JoinCourse" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label>Class Join Code</label>
                        <input type="text" name="sectionCode" placeholder="e.g. CRS-A1B2C3" required autocomplete="off" />
                    </div>
                    <button type="submit" class="btn-save"><i class="fa-solid fa-check"></i> Submit Code</button>
                </form>
            </div>
        </div>


    <script src="~/js/aside.js"></script>
    <script src="~/js/logout.js"></script>
    <script src="~/js/student-dashboard.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/notify.js"></script>
    <script>
            window.SystemAlerts = {
                success: @Html.Raw(Json.Serialize(TempData["Success"]?.ToString())),
                error: @Html.Raw(Json.Serialize(TempData["Error"]?.ToString()))
                         };
    </script>
</body>
</html>